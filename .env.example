# Copy to .env and replace the value with output of: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
SEED_DATA=true
# Optional overrides for demo passwords (only used when seeding):
# DEMO_ADMIN_PASSWORD=admin12345
# DEMO_USER_PASSWORD=user12345

# Optional host/local ports when the defaults are occupied:
# GATEWAY_PORT=18080
# BOOKING_PORT=18081
# HOTEL_PORT=18082
# DISCOVERY_PORT=18761
